    "inputs": {
      "bundle": ["4", 0],
      "keys": "name",
      "overrides.override0": ["5", 0]
    },
    "_meta": {"title": "Piercer (overrides name)"}
  },
  "7": {
    "class_type": "Unbundler",
    "inputs": {"bundle": ["6", 0], "keys": "name,age,score"},
    "_meta": {"title": "Unbundler"}
  },
  "8": {
    "class_type": "TextConcat",
    "inputs": {
      "parts.text0": ["7", 0],
      "parts.text1": ["7", 1],
      "parts.text2": ["7", 2],
      "separator": " | "
    },
    "_meta": {"title": "Join extracted values"}
  },
  "9": {
    "class_type": "MarkdownViewer",
    "inputs": {
      "markdown": ["8", 0],
      "heading": "Bundling Roundtrip",
      "history_id": "bundling_demo_view",
      "max_entries": 50,
      "append": true,
